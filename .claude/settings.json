{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(node node_modules/typescript/bin/tsc --noEmit)",
      "Bash(npm run build)",
      "Bash(npm run tauri build)",
      "Bash(npm run tauri build *)",
      "Bash(npm run tauri dev)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "Bash(python scripts/check-capacity-reference.py --check)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npx vitest run)",
      "PowerShell(npx vitest run *)",
      "PowerShell(node node_modules/typescript/bin/tsc --noEmit)",
      "PowerShell(npm run build)",
      "PowerShell(npm run tauri build)",
      "PowerShell(npm run tauri build *)",
      "PowerShell(npm run tauri dev)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo check *)",
      "PowerShell(cargo fmt *)",
      "PowerShell(cargo build *)",
      "PowerShell(python scripts/check-capacity-reference.py --check)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)"
    ],
    "deny": [
      "Read(//**/*.sqlite)",
      "Read(//**/*.sqlite3)",
      "Read(//**/*.sqlite-*)",
      "Read(//**/*.sqlite3-*)",
      "Read(//**/*.db)",
      "Read(//**/*.db-*)",
      "Read(//**/*.xlsx)",
      "Read(//**/*.xlsm)",
      "Read(//**/*.xls)"
    ]
  }
}
