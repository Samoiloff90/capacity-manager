# SQLite migration checksums depend on exact source bytes.
*.sql text eol=lf
src-tauri/permissions/autogenerated/*.toml text eol=lf

# Generated icons (npx tauri icon); see README.
*.png binary
*.ico binary
*.icns binary

# Shell scripts run under bash on Windows runners too.
*.sh text eol=lf

# Tests import these scripts through Vite, which rejects a hashbang line ending in CRLF.
*.mjs text eol=lf

# Packed into the Windows ZIP: same bytes (and hash) from local and CI builds.
packaging/windows/README-PORTABLE.txt text eol=lf
